include "root" {
  path   = find_in_parent_folders("root.hcl")
  expose = true
}

terraform {
  source = "${find_in_parent_folders("modules/vendor")}//website-hosting"
}

# The module requests its ACM certificate through an `aws.us_east_1` alias
# provider (CloudFront only accepts certificates from us-east-1), on top of
# the stack's own provider generated by root.hcl.
generate "provider_us_east_1" {
  path      = "provider_us_east_1.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<EOF
provider "aws" {
  alias   = "us_east_1"
  region  = "us-east-1"
  profile = "${include.root.locals.aws_profile}"

  allowed_account_ids = ["${include.root.locals.aws_account_id}"]

  default_tags {
    tags = local.default_tags
  }
}
EOF
}

# The Route 53 records are created through an `aws.dns` alias provider, because
# the hosted zone is in the network-hub account of the organization. It assumes
# the role that account gives to the one this project is deployed from. The role
# below is the transitional one of the old account: use
# `awslz-dns-<account name>` once the project runs in a workload account.
generate "provider_dns" {
  path      = "provider_dns.tf"
  if_exists = "overwrite_terragrunt"
  contents  = <<EOF
provider "aws" {
  alias   = "dns"
  region  = "us-east-1"
  profile = "${include.root.locals.aws_profile}"

  assume_role {
    role_arn = "arn:aws:iam::000000000000:role/awslz-dns-legacy"
  }

  allowed_account_ids = ["000000000000"]

  default_tags {
    tags = local.default_tags
  }
}
EOF
}

locals {
  bucket_name = "${include.root.locals.environment_name_prefix}-website-${include.root.locals.aws_account_id}-${include.root.locals.aws_region}-an"
}

inputs = {
  s3_bucket_name                        = local.bucket_name
  cloudfront_distribution_name          = "${include.root.locals.environment_name_prefix}-website"
  cloudfront_origin_access_control_name = "${local.bucket_name}-oac"

  domain_name     = values.domain_name
  route53_zone_id = values.route53_zone_id

  s3_bucket_force_destroy      = try(values.s3_bucket_force_destroy, false)
  s3_bucket_versioning_enabled = try(values.s3_bucket_versioning_enabled, false)
}
