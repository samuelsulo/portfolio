## $util.escapeJavaScript also escapes single quotes as \' (needed for a
## JS string literal, invalid as a JSON escape): stripped back to a bare
## quote here. Needs 4 backslashes in this source: #set's own string
## literal collapses \\ to one backslash before replaceAll ever sees the
## pattern, so 2 backslashes here would leave replaceAll matching (and
## replacing with itself) a bare quote, not the \' sequence to fix.
#set($templateData = $templateData.replaceAll("\\\\'","'"))
Action=SendTemplatedEmail
&Source=$util.urlEncode($source)
#foreach($toAddress in $toAddresses.split(","))
&Destination.ToAddresses.member.$foreach.count=$util.urlEncode($toAddress)
#end
&ReplyToAddresses.member.1=$util.urlEncode($body.email)
&TemplateData=$util.urlEncode($templateData)
&Template=$util.urlEncode($template)