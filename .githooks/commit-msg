#!/bin/sh
# Enforce Conventional Commits on the commit message subject line.
# See CLAUDE.md §10. Reused as-is by every client project cloned from this
# template: scope is free-form (whatever area of the project the commit
# touches), not checked against a fixed folder list, since that varies from
# client to client (application code added per project, see CLAUDE.md §1).

set -e

commit_msg_file="$1"

# Skip validation for merge commits: their subject line ("Merge branch ...")
# is generated by git itself, not written by hand.
git_dir=$(git rev-parse --git-dir 2>/dev/null) || git_dir=".git"
if [ -f "$git_dir/MERGE_HEAD" ]; then
  exit 0
fi

subject_line=$(head -n 1 "$commit_msg_file")

# fixup!/squash! commits are intentionally left unchecked: they exist to be
# squashed into a properly formatted commit before merging, not to stand on
# their own.
case "$subject_line" in
  "fixup! "*|"squash! "*) exit 0 ;;
esac

allowed_types="feat|fix|refactor|docs|chore|test|style|perf|build|ci|revert"
pattern="^(${allowed_types})\(([a-z0-9-]+)\)!?: .{1,100}$"

if ! echo "$subject_line" | grep -qE "$pattern"; then
  cat >&2 <<EOF
✗ Commit message non valido: non segue Conventional Commits.

  Ricevuto:
    $subject_line

  Formato atteso:
    <type>(<scope>): <description>

  type ammessi: feat, fix, refactor, docs, chore, test, style, perf, build, ci, revert
  scope: kebab-case, l'area del progetto toccata dal commit (es.
         infrastructure, modules, docs).

  Esempi:
    feat(infrastructure): add cloudfront distribution
    fix(modules): correct budget threshold comparison
    docs(readme): update deployment guide

  Vedi CLAUDE.md §10.
EOF
  exit 1
fi

exit 0
