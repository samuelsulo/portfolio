#!/usr/bin/env bash
#
# Formats staged Terraform files before every commit (CLAUDE.md §5:
# `terraform fmt` is part of the deploy process, not optional). Only the
# files actually staged for this commit are touched: unlike `make fmt`
# (whole tree), this never reformats files you aren't committing.
#
# If a file has both staged and unstaged hunks (partial `git add -p`), any
# unstaged edits are isolated with a temporary stash before formatting, so
# formatting and re-staging only ever see exactly what's staged. Restoring
# that stash happens in .githooks/post-commit, not here: popping it can
# conflict with what formatting just changed, and doing that *before* the
# commit exists would corrupt the index git is about to commit from. Doing
# it after means a conflict there can never break the commit itself.
#
# Reused as-is by every client project cloned from this template.

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)

staged=$(git -C "$repo_root" diff --cached --name-only --diff-filter=ACMR -- infrastructure \
  | grep -E '\.(tf|tfvars|hcl)$' || true)

if [ -z "$staged" ]; then
  exit 0
fi

if ! command -v terraform >/dev/null 2>&1; then
  echo "✗ 'terraform' not found on PATH: can't run 'make fmt-staged'." >&2
  echo "  If you use mise, run this from a shell where 'mise activate' already" >&2
  echo "  ran (the same one where 'make plan' works), or run 'mise install' first." >&2
  exit 1
fi

# Isolate unstaged edits so formatting + re-staging below only ever sees
# exactly what's in the index, not whatever else happens to be dirty.
# .githooks/post-commit restores this stash once the commit exists, using
# stash@{0}^2 (the index at stash time, i.e. pre-format) vs stash@{0} (the
# full worktree) to isolate exactly the unstaged hunks, independent of
# whatever formatting/committing does to the staged content afterwards. If
# we abort below instead (no commit will happen), restore it right away
# with a plain pop: there's no commit to protect from a conflict here.
stash_created=0
if [ -n "$(git -C "$repo_root" diff --name-only)" ]; then
  git -C "$repo_root" stash push --keep-index -q -m "pre-commit: isolate unstaged changes"
  stash_created=1
fi

restore_on_failure() {
  local status=$?
  if [ "$stash_created" -eq 1 ] && [ "$status" -ne 0 ]; then
    if ! git -C "$repo_root" stash pop -q; then
      echo "⚠ Could not automatically restore your unstaged changes after the" >&2
      echo "  aborted commit. They are safe in the stash:" >&2
      git -C "$repo_root" stash list | head -1 >&2
      echo "  Resolve manually with 'git stash pop'." >&2
    fi
  fi
}
trap restore_on_failure EXIT

abs_files=""
while IFS= read -r f; do
  abs_files="$abs_files $repo_root/$f"
done <<< "$staged"

if ! make -C "$repo_root/infrastructure" fmt-staged FILES="$abs_files" >/dev/null; then
  echo "✗ 'make fmt-staged' failed: fix the Terraform syntax error above before committing." >&2
  exit 1
fi

while IFS= read -r f; do
  git -C "$repo_root" add -- "$f"
done <<< "$staged"

exit 0
